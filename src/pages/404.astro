---
import Base from "../layouts/Base.astro";
import { u } from "../lib/banco";
const base = import.meta.env.BASE_URL;
---
<Base titulo="No encontrada · Banco de Gráficos POPULI" descripcion="Esa gráfica no existe o cambió de dirección.">
  <main class="wrap pg">
    <span class="kicker">404</span>
    <h1>Esa gráfica no está acá</h1>
    <p class="sub">Puede que haya cambiado de nombre o que el enlace esté incompleto. Buscala en el Banco.</p>
    <a class="btn" href={u(base, "/")}>Ir al Banco de Gráficos</a>
  </main>
</Base>
