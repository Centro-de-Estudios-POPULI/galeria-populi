---
import Base from "../layouts/Base.astro";
import { categorias, graficas, meta, u, norm, modoLabel, grupoDe, SITE } from "../lib/banco";
const base = import.meta.env.BASE_URL;
const cats = Object.entries(categorias);
const nMapas = graficas.filter((g) => g.tipo === "mapa").length;
const nMundo = graficas.filter((g) => g.tipo === "mapa_mundial").length;
const nCat = Object.fromEntries(cats.map(([k]) => [k, graficas.filter((g) => g.categoria === k).length]));
const desc = "Gráficas e indicadores de Bolivia con fuente verificada: mapas municipales del Censo y del Atlas Fiscal, mapas del mundo y series económicas, en alta resolución y listos para compartir.";
---
<Base titulo="Banco de Gráficos · Centro de Estudios POPULI" descripcion={desc} canonical={SITE}>
  <section class="hero">
    <div class="wrap">
      <span class="kicker">Gráficos abiertos · Bolivia</span>
      <h1>Banco de <em>Gráficos</em></h1>
      <p class="lead">Gráficas e indicadores de Bolivia con fuente verificada. Buscá, mirá y descargá la imagen
        <strong>en alta resolución, lista para compartir</strong>. Cada mapa municipal enlaza al atlas interactivo del que sale.</p>
      <div class="stats" aria-label="Contenido del Banco">
        <span><b>{graficas.length}</b>gráficas</span>
        <span><b>{nMapas}</b>mapas de los {meta.municipios} municipios</span>
        <span><b>{nMundo}</b>mapas del mundo</span>
      </div>
    </div>
  </section>

  <div class="controls">
    <div class="wrap">
      <div class="ctl-row">
        <label class="sr" for="busca">Buscar gráficas</label>
        <input id="busca" type="search" placeholder="Buscar por tema, indicador, fuente o etiqueta…" autocomplete="off" spellcheck="false" />
        <label class="sr" for="orden">Ordenar</label>
        <select id="orden">
          <option value="recientes">Más recientes</option>
          <option value="titulo">Título A–Z</option>
        </select>
      </div>
      <div class="chips" id="chips" role="group" aria-label="Categoría">
        <button class="chip" type="button" data-cat="*" aria-pressed="true">Todas<span class="n">{graficas.length}</span></button>
        {cats.map(([k, c]) => (
          <button class="chip" type="button" data-cat={k} style={`--c:${c.color}`} aria-pressed="false">{c.label}<span class="n">{nCat[k]}</span></button>
        ))}
      </div>
      <div id="aviso" class="aviso" hidden role="status">
        <span id="aviso-tx"></span>
        <button id="aviso-x" type="button">Ver todo el Banco</button>
      </div>
    </div>
  </div>

  <main class="wrap">
    <div id="grid" class="grid">
      {graficas.map((g) => {
        const c = categorias[g.categoria] ?? { label: g.categoria, color: "" };
        const grupo = grupoDe(g);
        const modo = modoLabel(g);
        const sub = [modo, grupo].filter(Boolean).join(" · ") || g.subtitulo;
        return (
          <article class="card" data-slug={g.slug} data-cat={g.categoria} data-fecha={g.fecha} data-grupo={[modo, grupo].filter(Boolean).join(" ")}
                   data-titulo={g.titulo} data-tags={(g.tags ?? []).join("|")}
                   data-sub={g.subtitulo ?? ""} data-fuente={g.fuente ?? ""} data-enlace={g.enlace ?? ""}
                   data-img={u(base, g.imagen)} data-datos={g.datos ? u(base, g.datos) : ""} data-catl={c.label} data-catc={c.color}>
            <a class="thumb" href={u(base, `g/${g.slug}/`)} data-visor aria-label={`Ver ${g.titulo}`}>
              <img src={u(base, g.thumb)} alt="" loading="lazy" decoding="async" width="600" height="600" />
            </a>
            <div class="meta">
              <span class="cat" style={`--c:${c.color}`}>{c.label}</span>
              <h3><a href={u(base, `g/${g.slug}/`)} data-visor>{g.titulo}</a></h3>
              <p class="sub">{sub}</p>
              <div class="acts">
                <a class="btn" href={u(base, g.imagen)} download={`${g.slug}.png`}>↓ Descargar</a>
                <a class="btn sec" href={u(base, `g/${g.slug}/`)}>Ficha</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <p id="vacio" class="vacio" hidden>No hay gráficas que coincidan con esa búsqueda.</p>
    <div id="mas" class="mas" hidden><button type="button" id="mas-btn">Mostrar más</button></div>
  </main>

  <dialog id="visor" class="visor" aria-labelledby="visor-t">
    <button class="visor-x" type="button" id="visor-x" aria-label="Cerrar">✕</button>
    <div class="visor-in">
      <div class="visor-img"><img id="visor-img" src="" alt="" /></div>
      <div class="visor-side">
        <div class="visor-nav">
          <button type="button" id="visor-prev" aria-label="Gráfica anterior">‹</button>
          <button type="button" id="visor-next" aria-label="Gráfica siguiente">›</button>
          <span class="cat" id="visor-cat"></span>
        </div>
        <h2 id="visor-t"></h2>
        <p class="sub" id="visor-sub"></p>
        <div class="tags" id="visor-tags"></div>
        <p class="fuente" id="visor-fuente"></p>
        <div class="btns">
          <a class="btn" id="visor-dl" href="" download>↓ Descargar PNG</a>
          <a class="btn sec" id="visor-atlas" href="" hidden>Ver en el atlas interactivo ↗</a>
          <a class="btn sec" id="visor-datos" href="" hidden>Datos (CSV)</a>
          <button class="btn sec" type="button" id="visor-copy">Copiar enlace</button>
          <a class="btn sec" id="visor-pg" href="">Abrir la ficha completa</a>
          <span class="copiado" id="visor-ok" hidden>Enlace copiado</span>
        </div>
      </div>
    </div>
  </dialog>

  <script define:vars={{ base, SITE }}>
    const norm = (t) => (t || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const $ = (s) => document.querySelector(s);
    const grid = $('#grid'), busca = $('#busca'), orden = $('#orden'), vacio = $('#vacio');
    const mas = $('#mas'), masBtn = $('#mas-btn'), aviso = $('#aviso'), avisoTx = $('#aviso-tx');
    const chips = [...document.querySelectorAll('.chip')];
    const cards = [...grid.querySelectorAll('.card')];
    const LOTE = 72;
    // el índice de búsqueda se arma acá y no viaja en el HTML: son 800 tarjetas
    cards.forEach((c) => { const d = c.dataset; d.heno = norm([d.titulo, d.sub, d.fuente, d.grupo, d.catl, d.slug, (d.tags || '').replace(/\|/g, ' ')].join(' ')); });
    const st = { q: '', cat: '*', tag: '', orden: 'recientes', g: '', limite: LOTE };

    // ---- estado en la URL: ?q= ?cat= ?tag= ?orden= ?g= ----
    function leerURL() {
      const p = new URLSearchParams(location.search);
      st.q = p.get('q') || ''; st.cat = p.get('cat') || '*'; st.tag = p.get('tag') || '';
      st.orden = p.get('orden') === 'titulo' ? 'titulo' : 'recientes'; st.g = p.get('g') || '';
      if (!chips.some((c) => c.dataset.cat === st.cat)) st.cat = '*';
    }
    function escribirURL() {
      const p = new URLSearchParams();
      if (st.q) p.set('q', st.q); if (st.cat !== '*') p.set('cat', st.cat); if (st.tag) p.set('tag', st.tag);
      if (st.orden !== 'recientes') p.set('orden', st.orden); if (st.g) p.set('g', st.g);
      const qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
    }

    // ---- filtro + orden + lote ----
    let visibles = [];
    function aplicar() {
      const q = norm(st.q).trim(), terms = q ? q.split(/\s+/) : [];
      const tag = st.tag;
      visibles = cards.filter((c) => {
        if (st.cat !== '*' && c.dataset.cat !== st.cat) return false;
        if (tag && !(c.dataset.tags || '').split('|').includes(tag)) return false;
        if (terms.length) { const h = c.dataset.heno || ''; if (!terms.every((t) => h.includes(t))) return false; }
        return true;
      });
      if (st.orden === 'titulo') visibles.sort((a, b) => a.dataset.titulo.localeCompare(b.dataset.titulo, 'es'));
      else visibles.sort((a, b) => (b.dataset.fecha || '').localeCompare(a.dataset.fecha || '') || a.dataset.titulo.localeCompare(b.dataset.titulo, 'es'));
      cards.forEach((c) => { c.hidden = true; });
      visibles.forEach((c, i) => { c.hidden = i >= st.limite; grid.appendChild(c); });
      vacio.hidden = visibles.length > 0;
      const resto = Math.max(0, visibles.length - st.limite);
      mas.hidden = resto === 0;
      masBtn.textContent = `Mostrar más (${resto} restantes)`;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === st.cat)));
      // aviso cuando se llega filtrado desde afuera (o por etiqueta, que no tiene chip)
      const partes = [];
      if (st.tag) partes.push(`etiqueta <b>${st.tag}</b>`);
      if (st.q) partes.push(`búsqueda <b>${st.q}</b>`);
      if (st.cat !== '*') { const ch = chips.find((c) => c.dataset.cat === st.cat); if (ch) partes.push(`categoría <b>${ch.firstChild.textContent}</b>`); }
      aviso.hidden = partes.length === 0;
      avisoTx.innerHTML = partes.length ? `Mostrando <b>${visibles.length}</b> de ${cards.length} gráficas · ${partes.join(' · ')}` : '';
      escribirURL();
    }
    busca.addEventListener('input', () => { st.q = busca.value; st.limite = LOTE; aplicar(); });
    orden.addEventListener('change', () => { st.orden = orden.value; aplicar(); });
    chips.forEach((ch) => ch.addEventListener('click', () => { st.cat = ch.dataset.cat; st.limite = LOTE; aplicar(); }));
    masBtn.addEventListener('click', () => { st.limite += LOTE; aplicar(); });
    $('#aviso-x').addEventListener('click', () => { st.q = ''; st.cat = '*'; st.tag = ''; st.limite = LOTE; busca.value = ''; aplicar(); busca.focus(); });

    // ---- visor: <dialog> nativo (foco, Esc y fondo resueltos por el navegador) ----
    const dlg = $('#visor'), vImg = $('#visor-img'), vT = $('#visor-t'), vSub = $('#visor-sub'), vF = $('#visor-fuente');
    const vDl = $('#visor-dl'), vAt = $('#visor-atlas'), vDa = $('#visor-datos'), vPg = $('#visor-pg'), vCat = $('#visor-cat');
    const vTags = $('#visor-tags'), vOk = $('#visor-ok'), vPrev = $('#visor-prev'), vNext = $('#visor-next');
    let actual = null, ultimoFoco = null;
    function mostrar(card) {
      actual = card; const d = card.dataset;
      vImg.src = d.img; vImg.alt = d.titulo;
      vT.textContent = d.titulo; vSub.textContent = d.sub; vF.textContent = d.fuente.replace(/^Fuente:\s*/, '');
      vCat.textContent = d.catl; vCat.style.setProperty('--c', d.catc);
      vDl.href = d.img; vDl.download = d.slug + '.png';
      vAt.hidden = !d.enlace; vAt.href = d.enlace || '';
      vDa.hidden = !d.datos; vDa.href = d.datos || '';
      vPg.href = base.replace(/\/$/, '') + '/g/' + d.slug + '/';
      vTags.innerHTML = (d.tags || '').split('|').filter(Boolean).slice(0, 6)
        .map((t) => `<a class="tag" href="?tag=${encodeURIComponent(t)}">${t}</a>`).join('');
      vTags.querySelectorAll('a').forEach((a) => a.addEventListener('click', (e) => {
        e.preventDefault(); dlg.close(); st.tag = a.textContent; st.q = ''; st.cat = '*'; st.limite = LOTE; busca.value = ''; aplicar();
        window.scrollTo({ top: grid.offsetTop - 140, behavior: 'smooth' });
      }));
      const i = visibles.indexOf(card);
      vPrev.disabled = i <= 0; vNext.disabled = i < 0 || i >= visibles.length - 1;
      vOk.hidden = true;
      st.g = d.slug; escribirURL();
      if (!dlg.open) { ultimoFoco = document.activeElement; dlg.showModal(); }
    }
    function mover(delta) { const i = visibles.indexOf(actual); const n = visibles[i + delta]; if (n) mostrar(n); }
    vPrev.addEventListener('click', () => mover(-1));
    vNext.addEventListener('click', () => mover(1));
    $('#visor-x').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { st.g = ''; escribirURL(); vImg.src = ''; if (ultimoFoco) ultimoFoco.focus(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') mover(-1); if (e.key === 'ArrowRight') mover(1); });
    $('#visor-copy').addEventListener('click', async () => {
      const url = SITE + 'g/' + actual.dataset.slug + '/';
      try { await navigator.clipboard.writeText(url); vOk.hidden = false; } catch (e) { prompt('Copiá el enlace:', url); }
    });
    document.querySelectorAll('[data-visor]').forEach((a) => a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;   // abrir en pestaña nueva sigue funcionando
      e.preventDefault(); mostrar(a.closest('.card'));
    }));
    document.addEventListener('keydown', (e) => { if (e.key === '/' && document.activeElement !== busca && !dlg.open) { e.preventDefault(); busca.focus(); } });

    // ---- arranque ----
    leerURL();
    busca.value = st.q; orden.value = st.orden;
    aplicar();
    if (st.g) { const c = cards.find((x) => x.dataset.slug === st.g); if (c) mostrar(c); else { st.g = ''; escribirURL(); } }
  </script>
</Base>
