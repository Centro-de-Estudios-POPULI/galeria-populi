---
// Cascarón común: cabecera con tokens de marca, tema claro/oscuro sin parpadeo,
// barra superior y pie. Las páginas ponen su título, descripción y su imagen OG.
import "../styles/paleta.css";
import "../styles/banco.css";
import { SITE, u } from "../lib/banco";
const { titulo, descripcion, og, canonical } = Astro.props as {
  titulo: string; descripcion: string; og?: string; canonical?: string;
};
const base = import.meta.env.BASE_URL;
const ogAbs = og ? (og.startsWith("http") ? og : SITE + og.replace(/^\//, "")) : SITE + "og.png";
const canon = canonical || SITE;
const FONTS = "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap";
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('tema');
        if (t !== 'dark' && t !== 'light')
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
    })();
  </script>
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canon} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Banco de Gráficos · Centro de Estudios POPULI" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canon} />
  <meta property="og:image" content={ogAbs} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content={ogAbs} />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23FAF8F3'/><text x='50' y='78' text-anchor='middle' font-size='84' font-family='Georgia,serif' font-weight='700' fill='%23C71E1D'>P</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={FONTS} rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="wordmark" href={u(base, "/")} aria-label="Banco de Gráficos POPULI"><span class="wm-p">P</span><span class="wm-rest">opuli</span></a>
      <span class="nombre">Banco de Gráficos</span>
      <span class="sp"></span>
      <nav aria-label="Herramientas relacionadas">
        <a href="https://centro-de-estudios-populi.github.io/Atlas-Fiscal-Municipal/Mapa_Censo_2024_Bolivia.html">Atlas Socioeconómico</a>
        <a href="https://centro-de-estudios-populi.github.io/Atlas-Fiscal-Municipal/mapa.html">Atlas Fiscal</a>
        <a href="https://populi.org.bo">populi.org.bo</a>
      </nav>
      <button id="tema" class="tema" type="button" aria-label="Cambiar entre tema claro y oscuro" aria-pressed="false">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M4.8 4.8l1.8 1.8M17.4 17.4l1.8 1.8M19.2 4.8l-1.8 1.8M6.6 17.4l-1.8 1.8"/></svg>
      </button>
    </div>
  </header>

  <slot />

  <footer class="foot">
    <div class="wrap">
      <span><span class="wm-p">P</span>opuli · Banco de Gráficos · Centro de Estudios de Políticas Públicas para la Libertad</span>
      <span class="links">
        <a href="https://populi.org.bo">populi.org.bo</a>
        <a href="https://centro-de-estudios-populi.github.io/Atlas-Fiscal-Municipal/Mapa_Censo_2024_Bolivia.html">Atlas Socioeconómico Municipal</a>
        <a href="https://centro-de-estudios-populi.github.io/Atlas-Fiscal-Municipal/mapa.html">Atlas Fiscal Municipal</a>
      </span>
    </div>
  </footer>

  <script>
    const b = document.getElementById('tema')!;
    const sync = () => b.setAttribute('aria-pressed', String(document.documentElement.getAttribute('data-theme') === 'dark'));
    sync();
    b.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('tema', next); } catch (e) {}
      sync();
    });
  </script>
</body>
</html>
