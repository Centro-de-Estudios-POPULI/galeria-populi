---
// El logo compacto de populi.org.bo, CALCADO de `astro-frontend/src/components/Logo.astro`
// (modo `compact`): mismo viewBox, mismas posiciones, tamaños y espaciado, misma altura
// (40 px en móvil, 44 en tablet, 48 en escritorio). Cambia sólo el color según el fondo:
// sobre navy la variante oscura del sitio (P coral, opuli papel); sobre papel la clara.
const { variante = "oscuro", class: className = "" } = Astro.props as { variante?: "oscuro" | "claro"; class?: string };
---
<svg viewBox="0 0 310 130" xmlns="http://www.w3.org/2000/svg" class:list={["logo", variante, className]} aria-hidden="true">
  <text x="6" y="112" font-family="'Playfair Display', Georgia, serif" font-size="145" font-weight="700" class="logo-p">P</text>
  <text x="92" y="87" font-family="'Playfair Display', Georgia, serif" font-size="55" font-weight="400" font-style="italic" letter-spacing="1" class="logo-rest">opuli</text>
</svg>
